#!/bin/sh
# Pre-commit checks for WikiPortraits Eval.
#
#   * the offline suites always run — fast, deterministic, no network, no excuses
#   * the live Commons check runs ONLY when `default_list.txt` itself changed, because the one
#     thing that can make it fail for reasons that are not yours is Wikimedia being unavailable
#     or rate-limiting us. It must not gate an unrelated commit.
#
# Escape hatches:
#   SKIP_LIVE=1  git commit …     # offline checks only
#   SKIP_HOOKS=1 git commit …     # nothing at all
#
# Enable it once per clone (hooks are not versioned automatically):
#   git config core.hooksPath .githooks
set -e
root=$(git rev-parse --show-toplevel)
cd "$root"

if [ -n "$SKIP_HOOKS" ]; then
  echo "pre-commit: skipped (SKIP_HOOKS set)"
  exit 0
fi

fail=0
# One inventory, in tests/suites.py, shared with CI and run_all_tests.sh. It used to be a list here, a
# different list in the workflow and a third in run_all_tests.sh — and they had drifted (a suite that
# ran nowhere, a PDF check with no assertions). It also refuses to let a suite exist unclassified.
if ! out=$(python3 tests/suites.py 2>&1); then
  echo "pre-commit: suites FAILED"
  printf '%s\n' "$out" | tail -30
  fail=1
else
  printf '%s\n' "$out" | grep -E '^(  skip|result:)' || true
fi

[ "$fail" = 0 ] || exit 1

# --- the starter list is the one thing worth a network check, and only when it changed -------
if git diff --cached --name-only --diff-filter=ACM | grep -qx 'default_list.txt'; then
  if [ -n "$SKIP_LIVE" ]; then
    echo "pre-commit: default_list.txt changed — live Commons check SKIPPED (SKIP_LIVE set)"
  else
    echo "pre-commit: default_list.txt changed — verifying every entry on Commons (1 API call)…"
    python3 test_default_list.py --live || exit 1
  fi
fi

echo "pre-commit: ok"
