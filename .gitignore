# dev/runtime artifacts — never deploy or commit
cache/
serve/
node_modules/
# no lockfile: the only npm dependency is jsdom, used solely by tests/test_render_dom.js, and
# the repo is deliberately stdlib-Python-only otherwise. Pinning 40 transitive packages for one
# dev-only test is more maintenance than it buys. `npm install` still works.
package-lock.json
.venv-pdf/
__pycache__/
*.pyc
static/_index_extracted.js
# written by test_pdf_images.py on every run, so tracking them made the repo churn on any PDF change
research/pdfmin_image_test.pdf
research/pdfmin_image_test.png
*.tar.gz
*.log
server.log
.DS_Store
.playwright-cli/
